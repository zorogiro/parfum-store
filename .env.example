# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/parfum_store?schema=public"

# Auth.js secret (generate with: npx auth secret)
AUTH_SECRET=""

# Cloudinary (product images). The API secret must stay server-side only.
