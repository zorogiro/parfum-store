# Copy to .env for LOCAL development (.env is gitignored). Placeholders only: never commit real
# values, and never put PRODUCTION connection strings in .env (see docs/DEPLOY.md).
#
# Legend:  [required] the app does not work without it   [optional] has a safe default / feature off
#          (secret) never expose it   (public) inlined in the browser bundle at build time
#          Where: "runtime" = read by the running app, "build" = read during `next build`,
#          "cli" = only by scripts/CLI run from your machine.

# --- Database (Neon PostgreSQL) -------------------------------------------------------------
# [required, secret, runtime + build] POOLED connection (host contains "-pooler"). The app uses it,
# and `next build` queries it to prerender product/category pages.
DATABASE_URL="postgresql://user:password@host-pooler.example.com:5432/neondb?sslmode=require"
# [required for migrations and seeds, secret, cli] DIRECT connection (host WITHOUT "-pooler").
# Used by `prisma migrate` and the seed scripts. Not needed by the running app.
DIRECT_URL="postgresql://user:password@host.example.com:5432/neondb?sslmode=require"

# --- Admin authentication (Auth.js) ---------------------------------------------------------
# [required, secret, runtime] Generate with: npx auth secret   (the app refuses to start without it).
# It also keys the rate-limit hashes, so rotating it resets the rate-limit counters.
AUTH_SECRET=""
# [optional, runtime] Only when self-hosting / running `next start` outside Vercel (Vercel is trusted
# automatically). Do not set it on Vercel.
# AUTH_TRUST_HOST=true

# --- Seed users (cli only, never set on Vercel) ---------------------------------------------
# Dev seed (`npm run db:seed`) and production seed (`npm run db:seed:prod`). Use a strong password
# (the production seed refuses fewer than 12 characters).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Production seed only; set them in the shell for ONE command, never here:
# CONFIRM_PRODUCTION_SEED=yes   (required to run the production seed)
# RESET_ADMIN_PASSWORD=1        (overwrite the password of an existing admin; off by default)

# --- Cloudinary (product images) ------------------------------------------------------------
# [required for image upload, runtime]. CLOUDINARY_CLOUD_NAME is also read at BUILD time (it narrows
# the allowed image path in next.config.ts), so set it for Build too.
CLOUDINARY_CLOUD_NAME=""
# [required for image upload, secret, runtime]
CLOUDINARY_API_KEY=""
# [required for image upload, secret, runtime] Server-side only.
CLOUDINARY_API_SECRET=""

# --- Resend (order emails) ------------------------------------------------------------------
# [optional but recommended, secret, runtime] Without it, orders still work but no email is sent.
RESEND_API_KEY=""
# [optional, runtime] Sender address. "onboarding@resend.dev" is for testing only (Resend delivers
# it to your own account email). In production use an address on a domain verified in Resend, e.g.
# "Parfum Store <commandes@your-domain.tn>".
RESEND_FROM=onboarding@resend.dev

# --- Site URL -------------------------------------------------------------------------------
# [required in production, public, build] Canonical links, Open Graph, sitemap. No trailing slash.
# Because it is inlined at build time, redeploy after changing it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Sentry (optional error monitoring; everything is off when the DSN is empty) --------------
# [optional, runtime] Server-side DSN.
SENTRY_DSN=""
# [optional, public, build] Browser DSN (same value). Browser events are tunnelled through
# /monitoring on our own domain, so no Sentry origin is added to the CSP.
NEXT_PUBLIC_SENTRY_DSN=""
# [optional, secret, build] Only to upload source maps at build time. Leave empty to skip uploads.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# --- Tests (cli only, never set on Vercel) --------------------------------------------------
# Lets the DB-writing tests run. ONLY with DATABASE_URL pointing to the Neon DEV branch.
# E2E_ALLOW_DB_WRITES=1
# Run Playwright against an already running server instead of starting one on port 3100.
# E2E_BASE_URL="http://localhost:3000"

# Set automatically, do not define: NODE_ENV, VERCEL_ENV (production | preview | development).
