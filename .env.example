# PostgreSQL connection strings (placeholders only; never commit real credentials)
# DATABASE_URL: pooled connection, used by the app at runtime.
# DIRECT_URL: direct (non-pooled) connection, used by Prisma migrate / seed.
# With Neon: DATABASE_URL host contains "-pooler", DIRECT_URL does not.
DATABASE_URL="postgresql://user:password@host-pooler.example.com:5432/parfum_store?sslmode=require"
DIRECT_URL="postgresql://user:password@host.example.com:5432/parfum_store?sslmode=require"

# Seed admin user (db:seed). Use a strong password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Auth.js secret (generate with: npx auth secret)
AUTH_SECRET=""
# Required when self-hosting / running `next start` outside Vercel (Vercel trusts its host automatically).
# AUTH_TRUST_HOST=true

# Cloudinary (product images). The API secret must stay server-side only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (order notification emails)
RESEND_API_KEY=""
# Sender address. "onboarding@resend.dev" only works for testing (Resend delivers it to your own account email).
# In production use an address on a domain verified in Resend, e.g. "Parfum Store <commandes@your-domain.tn>".
RESEND_FROM=onboarding@resend.dev

# Public site URL (canonical links, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
